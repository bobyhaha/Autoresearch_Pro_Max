{
  "id": "exp_demo_optimizer_confirmation_v1",
  "stage": "confirmation",
  "title": "Demo optimizer intervention confirmation",
  "question": "Does the candidate lower the fixed-budget score across preregistered replicates?",
  "mechanism": {
    "cause": "the candidate changes the optimizer update",
    "effect": "the measured score decreases",
    "chain": [
      "change the update rule",
      "change parameter movement",
      "change the fixed-budget endpoint score"
    ]
  },
  "hypothesis": {
    "statement": "The candidate lowers the score relative to control.",
    "prediction": "the mean of candidate minus control will be below -0.01"
  },
  "falsifier": {
    "statement": "A non-negative mean candidate-minus-control difference falsifies the registered mechanism prediction."
  },
  "metric": {
    "name": "score",
    "direction": "minimize"
  },
  "plan": [
    {
      "replicate_id": "seed_1",
      "arms": [
        {
          "name": "control",
          "argv": ["python", "examples/metric_emitter.py", "--value", "1.0", "--steps", "1000"],
          "env": {}
        },
        {
          "name": "candidate",
          "argv": ["python", "examples/metric_emitter.py", "--value", "0.95", "--steps", "1000"],
          "env": {}
        }
      ]
    },
    {
      "replicate_id": "seed_2",
      "arms": [
        {
          "name": "control",
          "argv": ["python", "examples/metric_emitter.py", "--value", "1.01", "--steps", "1000"],
          "env": {}
        },
        {
          "name": "candidate",
          "argv": ["python", "examples/metric_emitter.py", "--value", "0.96", "--steps", "1000"],
          "env": {}
        }
      ]
    },
    {
      "replicate_id": "seed_3",
      "arms": [
        {
          "name": "control",
          "argv": ["python", "examples/metric_emitter.py", "--value", "0.99", "--steps", "1000"],
          "env": {}
        },
        {
          "name": "candidate",
          "argv": ["python", "examples/metric_emitter.py", "--value", "0.94", "--steps", "1000"],
          "env": {}

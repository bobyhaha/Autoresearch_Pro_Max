# Deployment facts for the execution fleet. Copy to .env and fill in.
# .env is gitignored: the committed execution configs describe the SHAPE of the
# fleet, while each operator supplies their own box. records.read_json expands
# ${VAR} in any loaded config and fails loudly if one is missing.
OPHIS_SSH_KEY=/absolute/path/to/your/ssh/private_key
OPHIS_SSH_PORT=22
OPHIS_SSH_TARGET=user@your-gpu-host.example.com
OPHIS_REMOTE_ROOT=/home/user/ophis_v2
OPHIS_HOST_ID=your-host-id
